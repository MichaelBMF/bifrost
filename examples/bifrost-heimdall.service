[Unit]
Description=Bifrost home lab relay
After=network-online.target

[Service]
ExecStart=/usr/local/bin/bifrost heimdall -config /etc/bifrost/heimdall.json
DynamicUser=yes
StateDirectory=bifrost
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# If you add RestrictAddressFamilies=, include AF_NETLINK: the in-process
# WireGuard opens a netlink socket on Linux and fails to start without it.
Restart=always

[Install]
WantedBy=multi-user.target
