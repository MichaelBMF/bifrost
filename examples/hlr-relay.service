[Unit]
Description=Bifrost home lab relay
After=network-online.target

[Service]
ExecStart=/usr/local/bin/hlr relay -config /etc/hlr/relay.json
DynamicUser=yes
StateDirectory=hlr
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always

[Install]
WantedBy=multi-user.target
